#!/usr/bin/env bash
#
# .githooks/pre-push
#
# Runs before every `git push` to validate Terraform code.
# Install with: scripts/install-hooks.sh
#
# Checks:
#   1. terraform fmt -check  (all .tf files are formatted)
#   2. terraform validate    (in every folder with a Terraform config,
#                             EXCLUDING modules/ since they're validated
#                             indirectly by the root config that calls them)
#
# If either fails, the push is blocked. Fix the issue, then push again.

set -e  # exit on any error

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "▶ pre-push: checking Terraform formatting..."
if ! terraform fmt -check -recursive; then
    echo ""
    echo "❌ Formatting errors found."
    echo "   Run: terraform fmt -recursive"
    echo "   Then commit the changes and push again."
    exit 1
fi
echo "✅ Formatting OK."

echo ""
echo "▶ pre-push: validating Terraform configs..."

# Find every directory containing at least one .tf file, EXCLUDING:
#   - .terraform/ folders (provider cache, not user code)
#   - modules/ folders   (validated indirectly by the root)
FAILED=0
while IFS= read -r dir; do
    echo "  → validate in: $dir"
    if ! (cd "$dir" && terraform validate -no-color >/dev/null 2>&1); then
        echo "  ❌ Validation failed in $dir"
        (cd "$dir" && terraform validate -no-color)
        FAILED=1
    fi
done < <(find . -type f -name '*.tf' \
         -not -path './.terraform/*' \
         -not -path '*/.terraform/*' \
         -not -path './modules/*' \
         | xargs -n1 dirname | sort -u)

if [ "$FAILED" -ne 0 ]; then
    echo ""
    echo "❌ One or more Terraform directories failed validation."
    echo "   Fix the errors above, then push again."
    exit 1
fi

echo "✅ Validation OK."
echo ""
echo "🚀 pre-push checks passed. Pushing..."
exit 0
